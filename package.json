{
  "name": "diffs-cli",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm --dir web build && cargo build --release && scripts/copy-release-binary.sh",
    "dev": "pnpm --dir web build && cargo run --",
    "format": "pnpm format:rust && pnpm format:web",
    "format:rust": "cargo fmt",
    "format:web": "pnpm --dir web format",
    "lint": "pnpm lint:web && pnpm lint:rust",
    "lint:rust": "cargo clippy -- -D warnings",
    "lint:web": "pnpm --dir web lint",
    "test": "pnpm --dir web lint && pnpm --dir web build && cargo test"
  }
}
